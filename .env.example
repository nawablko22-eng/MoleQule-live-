# ---- Server ----
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
BASE_URL=http://localhost:4000

# ---- Google / YouTube (Google Cloud Console project, YouTube Data API v3
#      + YouTube Live Streaming API enabled, OAuth 2.0 client credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/youtube/oauth/callback
# After you complete the one-time OAuth flow at /api/youtube/oauth/start,
# the server prints a refresh token — put it here so it survives restarts.
GOOGLE_REFRESH_TOKEN=

# "Continue with Google" sign-in (any student/teacher, not just the
# channel owner) reuses GOOGLE_CLIENT_ID/SECRET above — if you've already
# set those up for YouTube live, sign-in starts working the moment you add
# this second redirect URI in Google Cloud Console -> your OAuth client ->
# Authorized redirect URIs (keep the YouTube one too, both are needed).
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---- Web Push (VAPID keys) ----
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# ---- Home page: YouTube Shorts folder ----
# A separate, MUCH simpler credential than the OAuth setup above — this is
# read-only public data, so a plain API key is enough (no consent screen,
# no refresh token). Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> API key. Make sure YouTube Data API v3 is enabled
# on the same project.
YOUTUBE_API_KEY=
# Your channel's handle (e.g. @CrackifyPrep) or its UC... channel ID
# (Settings -> Advanced settings on your channel, or youtube.com/account_advanced).
YOUTUBE_CHANNEL_ID=

# ---- Home page: social links ----
INSTAGRAM_URL=
FACEBOOK_URL=

# ---- Cart + Checkout (Razorpay) ----
# Optional. Without these, "Add to Cart -> Cart -> Pay" still works fully
# as a free demo checkout (see README) — good for testing the flow. Add a
# real Razorpay account's Key ID/Secret to actually collect payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional extra safety net — see README's "Selling courses" section for
# why. Set only after adding a webhook (payment.captured, order.paid) in
# your Razorpay dashboard pointing at BASE_URL + /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (SMTP) — "Forgot password?" reset emails ----
# Optional. Without these, forgot-password shows a clear "not set up yet"
# message instead of crashing. Any SMTP provider works: a Gmail account
# with an App Password, Resend's SMTP relay, SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if not set.
SMTP_FROM=

# ---- Telegram bot (unified inbox) ----
# Optional. Message @BotFather on Telegram -> /newbot -> paste the token
# it gives you here. No approval process, works the moment you add it —
# see README section 12.
TELEGRAM_BOT_TOKEN=
# Your bot's @username (without the @) — used to build the "Chat on
# Telegram" link shown to students.
TELEGRAM_BOT_USERNAME=

# ---- WhatsApp (Cloud API — unified inbox) ----
# Optional, needs real setup on Meta's side first — see README section 12.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you make up — paste the SAME value into the webhook setup
# screen in Meta's dashboard, it's just used to confirm the webhook is
# really yours.
WHATSAPP_VERIFY_TOKEN=
# The number your WhatsApp Business Account sends from, digits only,
# country code first, no "+" (e.g. 919876543210) — used to build the
# "Chat on WhatsApp" wa.me link shown to students. This can be set even
# without the three fields above, just to show that button.
WHATSAPP_DISPLAY_NUMBER=

# ---- AI ad creative (OpenAI Images) ----
# Optional. Without this, "Advertise this course" still generates a clean
# templated graphic (course title/price/branding) with zero setup — add
# this to get a real AI-generated photo/illustration instead. Get a key at
# platform.openai.com.
OPENAI_API_KEY=

# ---- Meta Ads (one-click Lead Generation campaigns) ----
# Optional, needs real setup on Meta's side first (Business Manager, an Ad
# Account with billing, a connected Page, ads_management permission) — see
# README section 13. Without these, "Advertise this course" still
# generates the image + ad copy for you to use in Ads Manager by hand.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_PAGE_ID=
